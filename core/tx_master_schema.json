{
  "schema_name": "suxing_tx_master_schema",
  "version": "1.1",
  "description": "一天大人 太素天尊・天訊文中央資料模型。GitHub 保存核定知識版本；Google Drive 保存原始證據；Notion管理任務、審核與發布。",
  "id_policy": {
    "canonical_master_id": "yts_id",
    "archive_id": "tx_id",
    "legacy_id": "legacy_id",
    "filename_uses": "tx_id",
    "canonical_format": "YTS-TX-YYYYMMDDHHMMSS-001",
    "archive_format": "TX-YYYYMMDDHHMMSS",
    "legacy_format": "TX-YYYYMMDD-NNN"
  },
  "required_fields": [
    "tx_id",
    "subject",
    "show_time",
    "category",
    "publish_status",
    "visibility",
    "license"
  ],
  "fields": {
    "yts_id": {
      "type": "string",
      "format": "YTS-TX-YYYYMMDDHHMMSS-001",
      "description": "YTS正式主ID。既有典藏分階段補入；新建物件必須建立。"
    },
    "tx_id": {
      "type": "string",
      "format": "TX-YYYYMMDDHHMMSS",
      "description": "本倉庫既有穩定典藏ID，必須與檔名一致。"
    },
    "legacy_id": {
      "type": "string",
      "format": "TX-YYYYMMDD-NNN",
      "description": "2026-06遷移前的TX ID，僅供追溯。"
    },
    "old_id": {
      "type": "string",
      "description": "網站或其他舊系統ID。"
    },
    "subject": {
      "type": "string"
    },
    "source_author": {
      "type": "string",
      "default": "一天大人 太素天尊"
    },
    "source_type": {
      "type": "string",
      "allowed_values": [
        "天訊文",
        "開示",
        "經典",
        "咒語",
        "素行文稿",
        "其他"
      ],
      "default": "天訊文"
    },
    "show_time": {
      "type": "datetime",
      "format": "YYYY-MM-DDTHH:MM:SS",
      "description": "現示時間，必須與tx_id時間戳一致。"
    },
    "publish_code": {
      "type": "string",
      "format": "YYYYMMDDHHMMSS",
      "description": "必須與tx_id的14碼時間戳一致。"
    },
    "category": {
      "type": "string",
      "description": "需對齊taxonomy_master.json。"
    },
    "tags": {
      "type": "array",
      "items": "string"
    },
    "keywords": {
      "type": "array",
      "items": "string",
      "max_items": 5
    },
    "char_count": {
      "type": "integer"
    },
    "reading_minutes": {
      "type": "integer"
    },
    "editor_intro": {
      "type": "string",
      "description": "整理層，不得冒充原文。"
    },
    "open_question": {
      "type": "string"
    },
    "related_ids": {
      "type": "array",
      "items": "tx_id",
      "description": "既有公開連結使用tx_id；知識圖譜可另存yts_id關聯。"
    },
    "meta_description": {
      "type": "string",
      "max_length": 150
    },
    "og_image": {
      "type": "url"
    },
    "url_slug": {
      "type": "string",
      "format": "tianxunwen-TX-YYYYMMDDHHMMSS"
    },
    "publish_status": {
      "type": "string",
      "allowed_values": [
        "draft",
        "review",
        "approved",
        "scheduled",
        "published",
        "archived",
        "hidden"
      ]
    },
    "published_platforms": {
      "type": "array",
      "items": "string"
    },
    "visibility": {
      "type": "string",
      "allowed_values": [
        "public",
        "internal",
        "restricted",
        "private",
        "hidden"
      ],
      "default": "public"
    },
    "github_path": {
      "type": "string"
    },
    "github_url": {
      "type": "url"
    },
    "notion_page_id": {
      "type": "string"
    },
    "canonical_url": {
      "type": "url"
    },
    "license": {
      "type": "string",
      "default": "CC BY-ND 4.0"
    }
  },
  "hard_rules": [
    "天訊文原文不得改寫、刪節、潤飾。",
    "所有衍生內容必須可回指yts_id或tx_id。",
    "整理層、詮釋層不得冒充一天大人原意。",
    "hidden、private或restricted內容不得自動發布。",
    "yts_id與tx_id必須唯一；既有ID不得重用。",
    "版本、語言、權限與審核狀態不得寫入正式主ID。"
  ]
}
